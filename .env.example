# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Supabase (required) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/sync-scores to write official results.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin (required for admin routes) ─────────────────────────────────
# Protects POST /api/admin/results and GET /api/waitlist (sent as the
# x-admin-secret header). If unset, both routes refuse every request.
ADMIN_SECRET=

# ── Testnet faucet (optional, on-chain demo only) ─────────────────────
RPC_URL=http://127.0.0.1:8545
FAUCET_PRIVATE_KEY=
MOCK_USDC_ADDRESS=
